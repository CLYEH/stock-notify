# 複製為 .env（正式）或 .env.development（測試）後填入實際值。
#
# 切換設定檔：
#   STOCK_ENV_FILE=.env.development python -m stock_notify
#   python -m stock_notify --env-file .env.development

# LINE Bot 設定
# LINE_USER_ID 的前綴決定收件對象：U=個人、C=群組、R=聊天室
LINE_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_id_here

# MongoDB 完整連線字串。未設定時仍可執行，但每次都要回補 30 個交易日
# （證交所歷史端點有 6 秒頻率限制，冷啟動約需 3 分鐘）
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# 成交量放大的判定倍數 (可選，預設 2.0)
VOLUME_MULTIPLIER=2.0

# 日誌層級 (可選，預設 INFO；設為 DEBUG 可看到逐檔明細)
LOG_LEVEL=INFO
